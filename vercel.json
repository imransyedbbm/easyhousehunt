{
  "rewrites": [
    {
      "source": "/l/:id",
      "destination": "/api/listing?id=:id"
    },
    {
      "source": "/s/:codes",
      "destination": "/api/shortlist?codes=:codes"
    },
    {
      "source": "/office-space",
      "destination": "/api/office"
    },
    {
      "source": "/office-space/:area",
      "destination": "/api/office?area=:area"
    },
    {
      "source": "/rent",
      "destination": "/api/rent"
    },
    {
      "source": "/rent/:area",
      "destination": "/api/rent?area=:area"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
